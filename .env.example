# ============================================================================
# HJ CODE AGENT V2 - Ejemplo de variables de entorno
# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.
# ============================================================================

# --- Obligatorio: token del bot de Telegram (de @BotFather) ---
HJ_TELEGRAM_BOT_TOKEN=

# --- Obligatorio: administradores (Telegram user_id separados por comas) ---
# Obten tu user_id con @userinfobot
HJ_ADMIN_USER_IDS=

# --- Rechazo de no autorizados ---
# 0 (defecto) = UN unico aviso con su user_id; luego silencio.
# 1 = silencio total: el bot no envia NADA a IDs no autorizados.
HJ_SILENT_REJECT=0

# --- Clave maestra de cifrado (boveda de credenciales) ---
# Opcion A: generar una aleatoria una sola vez y guardarla aqui:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HJ_MASTER_KEY=
# Opcion B: archivo con la clave (permisos 0600), separado de la base de datos
HJ_MASTER_KEY_FILE=/opt/hj-code-agent/data/master.key

# --- Rutas de datos ---
HJ_DATA_DIR=/opt/hj-code-agent/data
HJ_WORKSPACES_DIR=/opt/hj-code-agent/workspaces
HJ_BACKUPS_DIR=/opt/hj-code-agent/backups
HJ_DB_PATH=/opt/hj-code-agent/data/hj.db

# --- Proveedor inicial (DeepSeek). La API key se configura con /setapi ---
HJ_DEFAULT_PROVIDER=deepseek
HJ_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Opcional: precargar la API key por entorno en lugar del formulario /setapi
HJ_DEEPSEEK_API_KEY=

# Opcional: token de GitHub para seed inicial (recomendado: usar /github connect)
HJ_GITHUB_TOKEN=

# --- Sandbox ---
# auto = docker si esta disponible, si no local (solo desarrollo)
HJ_SANDBOX_BACKEND=auto
HJ_SANDBOX_IMAGE=python:3.12-slim
HJ_SANDBOX_MEMORY_MB=512
HJ_SANDBOX_CPUS=1.0
HJ_SANDBOX_PIDS=128
HJ_SANDBOX_TIMEOUT_S=120
# Politica de red por defecto de los sandboxes (1=con salida a Internet para instalar dependencias)
HJ_SANDBOX_NETWORK=1
# Ruta de workspaces VISTA POR DOCKER (cuando el bot corre en contenedor)
HJ_WORKSPACES_HOST_DIR=/opt/hj-code-agent/workspaces
# RED RECOMENDADA EN PRODUCCION: none (sin Internet) o una red docker dedicada
# HJ_DOCKER_NETWORK=hj-sbx

# --- Limites del agente ---
HJ_MAX_TASK_STEPS=24
HJ_MAX_CONCURRENT_TASKS=2

# --- Limites de subidas ---
HJ_MAX_FILE_MB=20
HJ_MAX_ZIP_FILES=2000
HJ_MAX_ZIP_UNPACKED_MB=200

# --- Formulario seguro /setapi (solo loopback; usar tunel SSH) ---
HJ_FORM_HOST=127.0.0.1
HJ_FORM_PORT=8977
# Si publicas el formulario tras un proxy HTTPS, pon aqui la URL base publica
HJ_FORM_BASE_URL=

# --- Logs ---
HJ_LOG_LEVEL=INFO
HJ_LOG_FILE=/opt/hj-code-agent/data/agent.log
